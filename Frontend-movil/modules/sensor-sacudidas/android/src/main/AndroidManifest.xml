<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Mantener la CPU despierta mientras la protección por sacudida está encendida -->
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <!-- Pedir que el sistema no duerma la app (ahorro de batería de Android y de cada marca) -->
  <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
  <!-- Android 11+: para poder abrir el "inicio automático" de cada marca hay que declarar sus apps -->
  <queries>
    <package android:name="com.transsion.phonemaster" />
    <package android:name="com.miui.securitycenter" />
    <package android:name="com.coloros.safecenter" />
    <package android:name="com.oppo.safe" />
    <package android:name="com.vivo.permissionmanager" />
    <package android:name="com.iqoo.secure" />
    <package android:name="com.huawei.systemmanager" />
    <package android:name="com.samsung.android.lool" />
    <package android:name="com.asus.mobilemanager" />
  </queries>
</manifest>
