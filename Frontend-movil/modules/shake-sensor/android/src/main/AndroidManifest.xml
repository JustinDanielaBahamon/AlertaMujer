<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Keep the CPU awake while shake protection is on -->
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <!-- Ask the system not to put the app to sleep (Android and brand battery savers) -->
  <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
  <!-- Record the microphone during an alert, also with the screen off -->
  <uses-permission android:name="android.permission.RECORD_AUDIO" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
  <!-- Android 11+: to open each brand's "auto start" screen its apps must be declared -->
  <queries>
    <package android:name="com.transsion.phonemaster" />
    <package android:name="com.miui.securitycenter" />
    <package android:name="com.coloros.safecenter" />
    <package android:name="com.oppo.safe" />
    <package android:name="com.vivo.permissionmanager" />
    <package android:name="com.iqoo.secure" />
    <package android:name="com.huawei.systemmanager" />
    <package android:name="com.samsung.android.lool" />
    <package android:name="com.asus.mobilemanager" />
  </queries>
  <application>
    <service
      android:name="expo.modules.shakesensor.AudioRecorderService"
      android:exported="false"
      android:foregroundServiceType="microphone" />
  </application>
</manifest>
