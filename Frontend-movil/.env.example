# Configuración de la API del backend
# Para producción o cuando el backend esté en otro servidor
# EXPO_PUBLIC_API_URL=http://tu-backend-url.com:8080

# Para desarrollo local (si el backend está en localhost):
# EXPO_PUBLIC_API_URL=http://localhost:8080

# Para emulador Android (si el backend está en el PC host):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8080

# Para dispositivo físico (reemplaza con la IP de tu PC):
# EXPO_PUBLIC_API_URL=http://192.168.1.X:8080
