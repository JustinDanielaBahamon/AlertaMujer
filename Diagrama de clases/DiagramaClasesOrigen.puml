@startuml
' ==========================
' COLORES POR PATRÓN
!define OBSERVER_COLOR #abe4f7
!define STRATEGY_COLOR #f7b1f7
!define SINGLETON_COLOR #fae951
!define CHAIN_COLOR #ba99fc
!define ADAPTER_COLOR #eb6c55
' ==========================

skinparam class {
  BackgroundColor<<Observer>> OBSERVER_COLOR
  BackgroundColor<<Strategy>> STRATEGY_COLOR
  BackgroundColor<<Singleton>> SINGLETON_COLOR
  BackgroundColor<<Chain>> CHAIN_COLOR
  BackgroundColor<<Adapter>> ADAPTER_COLOR
}

' ==========================
' INTERFACES DE PATRÓN OBSERVER
' ==========================
interface IObserver <<Observer>> {
  + actualizar(a: Alerta): void
}

interface ISubject <<Observer>> {
  + registrar(o: IObserver): void
  + eliminar(o: IObserver): void
  + notificar(): void
}

' ==========================
' INTERFAZ DE PATRÓN STRATEGY
' ==========================
interface IEstrategiaEnvio <<Strategy>> {
  + enviar(n: Notificacion): void
}



' ==========================
' USUARIO BASE
' ==========================
abstract class Usuario {
  - id: UUID
  - nombre: String
  - correo: String
  - telefono: String
  - contraseñaHash: String
  - estadoCuenta: EstadoCuenta
  + iniciarSesion(): boolean
  + cerrarSesion(): void
  + actualizarDatos(): void
}

class Usuaria {
  - identificacion: String
  - fechaRegistro: DateTime
  + registrarContacto(): void
  + activarAlerta(): void
  + finalizarAlerta(): void
  + registrarUbicacionFrecuente(): void
  + publicarContenido(): void
}

class Administrador {
  - nivelAcceso: String
  + visualizarEstadisticas(): void
  + gestionarUsuarias(): void
  + supervisarAlertas(): void
  + eliminarContenido(): void
}

Usuario <|-- Usuaria
Usuario <|-- Administrador

' ==========================
' CONTACTOS Y UBICACIONES
' ==========================
class Contacto <<Observer>> {
  - id: UUID
  - nombre: String
  - apellido: String
  - parentesco: String
  - telefono: String
  + actualizar(a: Alerta): void
  + recibirNotificacion(): void
}

class UbicacionFrecuente {
  - id: UUID
  - nombreLugar: String
  - latitud: Double
  - longitud: Double
  + editar(): void
  + eliminar(): void
}

Usuaria "1" *-- "0..*" Contacto
Usuaria "1" -- "0..*" UbicacionFrecuente

' ==========================
' ALERTA Y EVIDENCIAS
' ==========================
class Alerta <<Observer>> {
  - id: UUID
  - fechaHoraInicio: DateTime
  - fechaHoraFin: DateTime
  - tipo: TipoAlerta
  - estado: EstadoAlerta
  - observers: List<IObserver>
  + activar(): void
  + finalizar(): void
  + cancelar(): void
  + registrar(o: IObserver): void
  + eliminar(o: IObserver): void
  + notificar(): void
}

ISubject <|.. Alerta
IObserver <|.. Contacto
IObserver <|.. Estadistica

abstract class Evidencia {
  - id: UUID
  - fechaHora: DateTime
  - rutaArchivo: String
  + guardar(): void
  + subirANube(): void
}

class VideoEvidencia
class AudioEvidencia

Evidencia <|-- VideoEvidencia
Evidencia <|-- AudioEvidencia

Usuaria "1" -- "0..*" Alerta
Alerta "1" *-- "0..*" Evidencia

class Ubicacion {
  - id: UUID
  - latitud: Double
  - longitud: Double
  - precision: Double
  - fechaHora: DateTime
  + actualizar(): void
}

Alerta "1" *-- "1..*" Ubicacion

' ==========================
' BUILDER
' ==========================
class AlertaBuilder {
  - alerta: Alerta
  + crearNueva(): void
  + setTipo(tipo: TipoAlerta): AlertaBuilder
  + agregarUbicacion(u: Ubicacion): AlertaBuilder
  + agregarEvidencia(e: Evidencia): AlertaBuilder
  + agregarNotificacion(n: Notificacion): AlertaBuilder
  + build(): Alerta
}
AlertaBuilder --> Alerta

' ==========================
' STRATEGY (ENVÍO)
' ==========================
class EnvioSMS <<Strategy>>
class EnvioEmail <<Strategy>>
class EnvioPush <<Strategy>>
class EnvioWhatsapp <<Strategy>>

IEstrategiaEnvio <|.. EnvioSMS
IEstrategiaEnvio <|.. EnvioEmail
IEstrategiaEnvio <|.. EnvioPush
IEstrategiaEnvio <|.. EnvioWhatsapp

class Notificacion {
  - id: UUID
  - fechaEnvio: DateTime
  - estadoEnvio: EstadoEnvio
  - estrategia: IEstrategiaEnvio
  + enviar(): void
  + reintentar(): void
}
Alerta "1" -- "1..*" Notificacion
Notificacion "1" -- "1" Contacto

' ==========================
' SINGLETON
' ==========================
class GestorAlertas <<Singleton>> {
  - instancia: GestorAlertas
  - alertas: List<Alerta>
  - GestorAlertas()
  + getInstancia(): GestorAlertas
  + registrarAlerta(a: Alerta): void
  + obtenerAlertas(): List<Alerta>
}
GestorAlertas --> Alerta

' ==========================
' CHAIN OF RESPONSIBILITY
' ==========================
class FallbackFCM <<Chain>>
class FallbackSMS <<Chain>>
class FallbackEmail <<Chain>>

' ==========================
' ADAPTER
' ==========================
interface INotificador <<Adapter>>
class TwilioAdapter <<Adapter>>
class FCMAdapter <<Adapter>>

INotificador <|.. TwilioAdapter
INotificador <|.. FCMAdapter

@enduml