@startuml
' ==========================

' ==========================
interface IObserver {
  + actualizar(a: Alerta): void
}

interface ISubject {
  + registrar(o: IObserver): void
  + eliminar(o: IObserver): void
  + notificar(): void
}

interface IEstrategiaEnvio {
  + enviar(n: Notificacion): void
}

interface IComando { 
  + ejecutar(): void 
}

' ==========================
' USUARIO BASE
' ==========================
abstract class Usuario {
  - id: UUID
  - nombre: String
  - correo: String
  - telefono: String
  - contraseñaHash: String
  - estadoCuenta: EstadoCuenta
  + iniciarSesion(): boolean
  + cerrarSesion(): void
  + actualizarDatos(): void
}

class Usuaria {
  - identificacion: String
  - fechaRegistro: DateTime
  + registrarContacto(): void
  + activarAlerta(): void
  + finalizarAlerta(): void
  + registrarUbicacionFrecuente(): void
  + publicarContenido(): void
}

class Administrador {
  - nivelAcceso: String
  + visualizarEstadisticas(): void
  + gestionarUsuarias(): void
  + supervisarAlertas(): void
  + eliminarContenido(): void
}

Usuario <|-- Usuaria
Usuario <|-- Administrador

' ==========================
' CONTACTOS Y UBICACIONES
' ==========================
class Contacto {
  - id: UUID
  - nombre: String
  - apellido: String
  - parentesco: String
  - telefono: String
  + actualizar(a: Alerta): void
  + recibirNotificacion(): void
}

class UbicacionFrecuente {
  - id: UUID
  - nombreLugar: String
  - latitud: Double
  - longitud: Double
  + editar(): void
  + eliminar(): void
}

Usuaria "1" *-- "0..*" Contacto
Usuaria "1" -- "0..*" UbicacionFrecuente

' ==========================
' ALERTA Y EVIDENCIAS
' ==========================
class Alerta {
  - id: UUID
  - fechaHoraInicio: DateTime
  - fechaHoraFin: DateTime
  - tipo: TipoAlerta
  - estado: EstadoAlerta
  - observers: List<IObserver>

  + activar(): void
  + finalizar(): void
  + cancelar(): void

  + registrar(o: IObserver): void
  + eliminar(o: IObserver): void
  + notificar(): void
}

ISubject <|.. Alerta
IObserver <|.. Contacto
IObserver <|.. Estadistica

abstract class Evidencia {
  - id: UUID
  - fechaHora: DateTime
  - rutaArchivo: String
  + guardar(): void
  + subirANube(): void
}

class VideoEvidencia {
  - duracion: Double
}

class AudioEvidencia {
  - duracion: Double
}

Evidencia <|-- VideoEvidencia
Evidencia <|-- AudioEvidencia

Usuaria "1" -- "0..*" Alerta
Alerta "1" *-- "0..*" Evidencia

class Ubicacion {
  - id: UUID
  - latitud: Double
  - longitud: Double
  - precision: Double
  - fechaHora: DateTime
  + actualizar(): void
}

Alerta "1" *-- "1..*" Ubicacion

' ==========================
' BUILDER
' ==========================
class AlertaBuilder {
  - alerta: Alerta
  + crearNueva(): void
  + setTipo(tipo: TipoAlerta): AlertaBuilder
  + agregarUbicacion(u: Ubicacion): AlertaBuilder
  + agregarEvidencia(e: Evidencia): AlertaBuilder
  + agregarNotificacion(n: Notificacion): AlertaBuilder
  + build(): Alerta
}

AlertaBuilder --> Alerta

' ==========================
' FACTORY METHOD - EVIDENCIA
' ==========================
abstract class EvidenciaFactory {
  + crearEvidencia(): Evidencia
}

class VideoEvidenciaFactory
class AudioEvidenciaFactory

EvidenciaFactory <|-- VideoEvidenciaFactory
EvidenciaFactory <|-- AudioEvidenciaFactory

VideoEvidenciaFactory --> VideoEvidencia
AudioEvidenciaFactory --> AudioEvidencia

' ==========================
' STRATEGY (ENVÍO)
' ==========================
class EnvioSMS
class EnvioEmail
class EnvioPush
class EnvioWhatsapp

IEstrategiaEnvio <|.. EnvioSMS
IEstrategiaEnvio <|.. EnvioEmail
IEstrategiaEnvio <|.. EnvioPush
IEstrategiaEnvio <|.. EnvioWhatsapp

class Notificacion {
  - id: UUID
  - fechaEnvio: DateTime
  - estadoEnvio: EstadoEnvio
  - estrategia: IEstrategiaEnvio
  + enviar(): void
  + reintentar(): void
}

Alerta "1" -- "1..*" Notificacion
Notificacion "1" -- "1" Contacto

' ==========================
' FACTORY METHOD - NOTIFICACION
' ==========================
abstract class NotificacionFactory {
  + crearEstrategia(): IEstrategiaEnvio
}

class SMSFactory
class EmailFactory
class PushFactory
class WhatsappFactory

NotificacionFactory <|-- SMSFactory
NotificacionFactory <|-- EmailFactory
NotificacionFactory <|-- PushFactory
NotificacionFactory <|-- WhatsappFactory

SMSFactory --> EnvioSMS
EmailFactory --> EnvioEmail
PushFactory --> EnvioPush
WhatsappFactory --> EnvioWhatsapp

' ==========================
' COMMAND (CORREGIDO)
' ==========================
class ActivarAlertaCommand {
  - alerta: Alerta
  + ejecutar(): void
}

class FinalizarAlertaCommand {
  - alerta: Alerta
  + ejecutar(): void
}

class CancelarAlertaCommand {
  - alerta: Alerta
  + ejecutar(): void
}

class EditarPublicacionCommand
class EliminarPublicacionCommand

IComando <|.. ActivarAlertaCommand
IComando <|.. FinalizarAlertaCommand
IComando <|.. CancelarAlertaCommand
IComando <|.. EditarPublicacionCommand
IComando <|.. EliminarPublicacionCommand

class Invocador {
  - comando: IComando
  + setComando(c: IComando): void
  + ejecutarComando(): void
}

Invocador --> IComando

' ==========================
' SINGLETON
' ==========================
class GestorAlertas {
  - instancia: GestorAlertas
  - alertas: List<Alerta>
  - GestorAlertas()
  + getInstancia(): GestorAlertas
  + registrarAlerta(a: Alerta): void
  + obtenerAlertas(): List<Alerta>
}

GestorAlertas --> Alerta

' ==========================
' PUBLICACIONES Y COMENTARIOS
' ==========================
class Publicacion {
  - id: UUID
  - contenido: String
  - fechaPublicacion: DateTime
  + editar(): void
  + eliminar(): void
}

class Comentario {
  - id: UUID
  - contenido: String
  - fecha: DateTime
  + editar(): void
  + eliminar(): void
}

Usuaria "1" -- "0..*" Publicacion
Publicacion "1" -- "0..*" Comentario
Usuaria "1" -- "0..*" Comentario

' ==========================
' ESTADÍSTICAS
' ==========================
class Estadistica {
  - totalAlertas: int
  - alertasActivas: int
  - alertasFinalizadas: int
  + generarReporte(): void
  + actualizar(a: Alerta): void
}

Administrador -- Estadistica
Administrador -- Publicacion
Administrador -- Alerta

@enduml